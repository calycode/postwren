{
   "$schema": "node_modules/wrangler/config-schema.json",
   "name": "mailer-cloudflare-dev",
   "main": "packages/api/src/index.ts",
   "compatibility_date": "2026-09-01",
   "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
   "assets": {
      "directory": "packages/webapp/dist/client",
      "binding": "ASSETS",
      "not_found_handling": "single-page-application",
      "run_worker_first": ["/api/*", "/t/*", "/u/*", "/media/*", "/mcp", "/oauth/*", "/.well-known/*"],
   },
   "d1_databases": [
      {
         "binding": "DB",
         "database_name": "mailer-cloudflare-dev",
         "database_id": "00000000-0000-0000-0000-000000000000",
         "migrations_dir": "migrations",
      },
   ],
   "r2_buckets": [
      {
         "binding": "MEDIA",
         "bucket_name": "mailer-cloudflare-media-dev",
      },
   ],
   "queues": {
      "producers": [{ "binding": "CAMPAIGN_QUEUE", "queue": "mailer-campaigns-dev" }],
      "consumers": [
         {
            "queue": "mailer-campaigns-dev",
            "max_batch_size": 100,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "dead_letter_queue": "mailer-campaigns-dev-dlq",
         },
      ],
   },
   "triggers": {
      "crons": ["* * * * *"],
   },
   "vars": {
      "APP_URL": "http://localhost:8787",
      "ENVIRONMENT": "development",
      "EMAIL_FROM": "noreply@example.com",
      "OWNER_EMAIL": "dev@example.com",
      "SESSION_SECRET": "dev-only-insecure-session-secret",
      "TOKEN_SECRET": "dev-only-insecure-token-secret",
   },
}
