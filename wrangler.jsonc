{
   "$schema": "node_modules/wrangler/config-schema.json",
   "name": "postwren",
   "main": "packages/api/src/index.ts",
   "compatibility_date": "2026-09-01",
   "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
   "assets": {
      "directory": "packages/webapp/dist/client",
      "binding": "ASSETS",
      "not_found_handling": "single-page-application",
      "run_worker_first": [
         "/api/*",
         "/t/*",
         "/u/*",
         "/media/*",
         "/mcp",
         "/oauth/*",
         "/.well-known/*",
      ],
   },
   "d1_databases": [
      {
         "binding": "DB",
         "database_name": "postwren",
         "migrations_dir": "migrations",
      },
   ],
   "r2_buckets": [
      {
         "binding": "MEDIA",
         "bucket_name": "postwren-media",
      },
   ],
   "kv_namespaces": [
      {
         "binding": "OAUTH_KV",
         "id": "00000000000000000000000000000000",
      },
   ],
   "queues": {
      "producers": [{ "binding": "CAMPAIGN_QUEUE", "queue": "postwren-campaigns" }],
      "consumers": [
         {
            "queue": "postwren-campaigns",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_retries": 5,
            "dead_letter_queue": "postwren-campaigns-dlq",
         },
      ],
   },
   "send_email": [{ "name": "EMAIL" }],
   "triggers": {
      "crons": ["* * * * *"],
   },
   "observability": {
      "enabled": true,
   },
   "vars": {
      "APP_URL": "https://postwren.example.com",
      "ENVIRONMENT": "production",
      "EMAIL_FROM": "noreply@postwren.example.com",
      "OWNER_EMAIL": "",
   },
}
