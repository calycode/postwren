{
   "$schema": "node_modules/wrangler/config-schema.json",
   "name": "postwren",
   "main": "packages/api/src/index.ts",
   "compatibility_date": "2026-09-01",
   "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
   // A deploy builds the admin SPA before wrangler bundles the Worker. Appflare,
   // the Deploy button and `wrangler deploy` all run this; no extra step to pick.
   "build": {
      "command": "pnpm build",
   },
   "assets": {
      "directory": "packages/webapp/dist/client",
      "binding": "ASSETS",
      "not_found_handling": "single-page-application",
      // Every response, including the SPA fallback, must pass through the
      // Worker so the embed allowlist can set frame-ancestors. Static assets
      // are proxied to the assets binding unchanged.
      "run_worker_first": true,
   },
   "d1_databases": [
      {
         "binding": "DB",
         "database_name": "postwren",
         "migrations_dir": "migrations",
      },
   ],
   "r2_buckets": [
      {
         "binding": "MEDIA",
         "bucket_name": "postwren-media",
      },
   ],
   // All-zero placeholder on purpose: Appflare and the Deploy button create the
   // namespace and bind their own id. For a manual deploy, run `wrangler kv
   // namespace create OAUTH_KV` and put the returned id here.
   "kv_namespaces": [
      {
         "binding": "OAUTH_KV",
         "id": "00000000000000000000000000000000",
      },
   ],
   "queues": {
      "producers": [{ "binding": "CAMPAIGN_QUEUE", "queue": "postwren-campaigns" }],
      "consumers": [
         {
            "queue": "postwren-campaigns",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_retries": 5,
            "dead_letter_queue": "postwren-campaigns-dlq",
         },
      ],
   },
   "send_email": [{ "name": "EMAIL" }],
   "triggers": {
      "crons": ["* * * * *"],
   },
   "observability": {
      "enabled": true,
   },
   "secrets": {
      "required": ["SESSION_SECRET", "TOKEN_SECRET"],
   },
   // Settings the installer changes for their own deployment: Appflare's install
   // form lists these, and app settings edit them later.
   //
   // APP_URL empty means "use the origin the request arrived on", so a fresh
   // workers.dev or custom-domain deploy can sign in before anything is set.
   // Campaign mail is rendered by a queue consumer with no request, so set
   // APP_URL to the public origin before scheduling one.
   "vars": {
      "APP_URL": "",
      "ENVIRONMENT": "production",
      "EMAIL_FROM": "hello@no-reply.calycode.com",
      "OWNER_EMAIL": "hello@calycode.com",
   },
}
