{
   "name": "@postwren/email",
   "version": "0.1.0",
   "description": "Table-safe email IR, renderer and merge tags for Postwren",
   "license": "MIT",
   "type": "module",
   "sideEffects": false,
   "keywords": [
      "email",
      "email-marketing",
      "newsletter",
      "email-rendering",
      "html-email",
      "table-layout",
      "merge-tags"
   ],
   "files": [
      "dist",
      "README.md",
      "LICENSE"
   ],
   "main": "./dist/index.js",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "types": "./dist/index.d.ts",
         "import": "./dist/index.js"
      },
      "./ir": {
         "types": "./dist/ir/index.d.ts",
         "import": "./dist/ir/index.js"
      },
      "./render": {
         "types": "./dist/render/index.d.ts",
         "import": "./dist/render/index.js"
      },
      "./template": {
         "types": "./dist/template/index.d.ts",
         "import": "./dist/template/index.js"
      },
      "./package.json": "./package.json"
   },
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "test": "vitest run",
      "check-types": "tsc --noEmit",
      "build": "tsup",
      "lint": "eslint src",
      "prepublishOnly": "pnpm build"
   },
   "dependencies": {
      "zod": "^3.25.76"
   },
   "devDependencies": {
      "tsup": "^9.0.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.12"
   }
}
