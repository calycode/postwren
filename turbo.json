{
   "$schema": "https://turbo.build/schema.json",
   "remoteCache": {
      "apiUrl": "https://trc.calycode.com",
      "teamId": "team_calycode"
   },
   "tasks": {
      "build": {
         "dependsOn": ["^build"],
         "outputs": ["dist/**"],
         "env": ["VITE_API_BASE_URL"],
         "inputs": ["$TURBO_DEFAULT$", ".env*"]
      },
      "test": {
         "dependsOn": ["^build"]
      },
      "@postwren/api#test": {
         "dependsOn": ["^build", "@postwren/webapp#build"]
      },
      "check-types": {
         "dependsOn": ["^build"]
      },
      "lint": {}
   }
}
